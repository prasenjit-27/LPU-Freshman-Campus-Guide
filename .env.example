# MongoDB Database Connection String
# Example: mongodb://localhost:27017/lpufreshman or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://localhost:27017/lpufreshman

# NextAuth Configuration
# Generate a secure 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-generated-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google Maps JavaScript API Key
# 1. Enable Maps JavaScript API and Directions API in Google Cloud Console
# 2. Add HTTP Referrer restrictions: http://localhost:3000/* and your production domain
# 3. If left empty, the application will provide a graceful fallback directory listing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-restricted-browser-key
