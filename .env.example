# MongoDB Database Connection String
# Example: mongodb://localhost:27017/lpufreshman or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://localhost:27017/lpufreshman

# NextAuth Configuration
# Generate a secure 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-generated-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# (Optional) Any custom map or tile server configuration.
# OpenFreeMap + MapLibre GL JS operates without any API keys or paid quotas.
